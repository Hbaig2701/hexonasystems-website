{
  "name": "hexonasystems-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "npm run sync:sanity",
    "build": "next build",
    "prebuild": "npm run sync:sanity",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test && npm run lint && npm run check:contrast && npm run check:seo && npm run build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "test": "vitest run",
    "pretest": "npm run sync:sanity",
    "check:seo": "node scripts/check-seo.mjs && vitest run content/seo.test.ts",
    "indexnow": "node scripts/indexnow.mjs",
    "sync:sanity": "node scripts/sync-sanity.mjs"
  },
  "dependencies": {
    "@sanity/client": "^8.16.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@vercel/analytics": "^2.0.1",
    "next": "16.2.12",
    "next-sanity": "^13.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sanity": "^6.23.0",
    "server-only": "^0.0.1",
    "styled-components": "^6.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
