# Copy to .env.local for development, and set these in the Vercel project for
# preview + production. Nothing here has a safe default; the site runs without
# them but the lead pipeline and analytics do not.

# Canonical origin. Used for metadataBase, JSON-LD, sitemap and OG image URLs.
NEXT_PUBLIC_SITE_URL=https://hexonasystems.com

# --- Lead pipeline (§9.1) ---------------------------------------------------
# Where the /commission form sends a submission. This is a GoHighLevel inbound
# webhook URL: the lead posts straight into GHL and a GHL workflow fans it out
# to email, Slack and wherever else. There is no Make.com hop any more.
#
# The var is deliberately vendor-neutral. lib/lead.ts does not know or care
# what is on the other end of it, and this is already the second receiver.
#
# The payload carries `firstName`, `lastName` and `companyName` alongside the
# raw form fields, because that is what a GHL contact record wants and it
# saves building a mapping step that would silently break on a rename.
#
# WITHOUT THIS the submission is written to the server log in full and the
# visitor is still told it arrived, which is true - the site has their answers.
# Nothing reaches the CRM, and the log line says so loudly. Grep Vercel logs
# for "[lead]" to recover anything submitted before this was set.
LEAD_WEBHOOK_URL=
# Optional, sent as x-hexona-signature. GoHighLevel does not check it (the URL
# itself is the secret), so leave it blank unless something else sits here.
LEAD_WEBHOOK_SECRET=

# --- Rate limiting (§9.1, 5/min/IP) -----------------------------------------
# Without these, a per-instance in-memory limiter takes over. That is fine
# locally and NOT sufficient in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Analytics (§10.1) ------------------------------------------------------
# PostHog powers the audit funnel drop-off analysis. Leave blank and neither
# PostHog nor the cookie consent bar renders at all.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
